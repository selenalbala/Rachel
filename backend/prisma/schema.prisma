generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockMovementType {
  ENTRADA
  SALIDA
  AJUSTE
  CONSUMO_CITA
  VENTA
  MERMA
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  EN_CURSO
  FINALIZADA
  CANCELADA
  NO_PRESENTADA
}

enum BookingRequestStatus {
  PENDIENTE
  ACEPTADA
  DENEGADA
  PROPUESTA_CANCELADA
  PROPUESTA_ENVIADA
}

enum ProductUnit {
  UNIDAD
  GRAMO
  MILILITRO
  LITRO
}

enum AbsenceType {
  VACACIONES
  BAJA
  ASUNTO_PERSONAL
  FORMACION
  OTRO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id              String           @id @default(cuid())
  name            String
  alias           String?
  phone           String?
  email           String?          @unique
  birthday        DateTime?
  allergies       String?
  notes           String?
  lastService     String?
  googleSub       String?          @unique
  passwordHash    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  appointments    Appointment[]
  bookingRequests BookingRequest[]
}

model Employee {
  id              String           @id @default(cuid())
  name            String
  specialty       String?
  phone           String?
  email           String?
  color           String           @default("#B8A48A")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  appointments    Appointment[]
  absences        Absence[]
  bookingRequests BookingRequest[]
}

model Category {
  id              String           @id @default(cuid())
  name            String           @unique
  color           String           @default("#B8A48A")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  services        Service[]
  appointments    Appointment[]
  bookingRequests BookingRequest[]
}

model Service {
  id              String                  @id @default(cuid())
  name            String
  categoryId      String?
  description     String?
  imageData       String?
  durationMin     Int
  price           Decimal                 @db.Decimal(10, 2)
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  category        Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  appointments    AppointmentService[]
  bookingRequests BookingRequestService[]
  images          ServiceImage[]
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  imageData String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
}

model HeroImage {
  id        String   @id @default(cuid())
  imageData String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([position])
}

model Product {
  id        String               @id @default(cuid())
  name      String
  brand     String?
  category  String?
  supplier  String?
  unit      ProductUnit          @default(UNIDAD)
  quantity  Decimal              @default(0) @db.Decimal(12, 2)
  minimum   Decimal              @default(0) @db.Decimal(12, 2)
  cost      Decimal              @default(0) @db.Decimal(10, 2)
  price     Decimal              @default(0) @db.Decimal(10, 2)
  notes     String?
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  movements StockMovement[]
  usages    AppointmentProduct[]
}

model Appointment {
  id                 String               @id @default(cuid())
  clientId           String
  employeeId         String
  categoryId         String?
  startsAt           DateTime
  endsAt             DateTime
  status             AppointmentStatus    @default(PENDIENTE)
  notes              String?
  total              Decimal              @default(0) @db.Decimal(10, 2)
  paid               Boolean              @default(false)
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  client             Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee           Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  category           Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  services           AppointmentService[]
  products           AppointmentProduct[]
  movements          StockMovement[]

  @@index([startsAt])
  @@index([clientId])
  @@index([employeeId])
}

model AppointmentService {
  id            String       @id @default(cuid())
  appointmentId String
  serviceId     String?
  serviceName   String
  durationMin   Int
  unitPrice     Decimal      @db.Decimal(10, 2)
  discount      Decimal      @default(0) @db.Decimal(10, 2)
  finalPrice    Decimal      @db.Decimal(10, 2)
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model AppointmentProduct {
  id            String      @id @default(cuid())
  appointmentId String
  productId     String
  quantity      Decimal     @db.Decimal(12, 2)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  appointmentId  String?
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 2)
  previousStock  Decimal           @db.Decimal(12, 2)
  resultingStock Decimal           @db.Decimal(12, 2)
  reason         String?
  createdAt      DateTime          @default(now())
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  appointment    Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
}

model Absence {
  id         String      @id @default(cuid())
  employeeId String
  startsAt   DateTime
  endsAt     DateTime
  type       AbsenceType
  title      String
  notes      String?
  color      String      @default("#5B5B5F")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
}

model BookingRequest {
  id           String                  @id @default(cuid())
  clientId     String
  employeeId   String?
  categoryId   String?
  requestedAt  DateTime
  proposedAt   DateTime?
  status       BookingRequestStatus    @default(PENDIENTE)
  notes        String?
  adminNotes   String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  client       Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee     Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  category     Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  services     BookingRequestService[]

  @@index([requestedAt])
}

model BookingRequestService {
  id               String         @id @default(cuid())
  bookingRequestId String
  serviceId        String
  serviceName      String
  durationMin      Int
  price            Decimal        @db.Decimal(10, 2)
  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  service          Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
}
